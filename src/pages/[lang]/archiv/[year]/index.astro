---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { frontKonData } from '@/data/frontkon-data';
import type { Locale } from '@/data/types';
import { getText, mapTopics } from '@/utils/content';
import { getTranslation, getTranslationObject } from '@/utils/i18n';
import { languages, defaultLanguage } from '@/i18n/config';
import PhotoGallery from '@/components/PhotoGallery.astro';
import PhotoGalleryManager from '@/react/PhotoGalleryManager';

export function getStaticPaths() {
  const paths: Array<{ params: { lang: string; year: string } }> = [];
  
  languages.forEach((lang) => {
    frontKonData.years.forEach((year) => {
      paths.push({
        params: { lang, year: year.id },
      });
    });
  });
  
  return paths;
}

const { lang: langParam, year: yearParam } = Astro.params;
const lang: Locale = (langParam && languages.includes(langParam as Locale)) 
  ? (langParam as Locale) 
  : defaultLanguage;

const year = frontKonData.years.find((y) => y.id === yearParam);
if (!year) {
  return Astro.redirect(`/${lang}/archiv/`);
}

const base = import.meta.env.BASE_URL || '/';
const pref = (path: string) => `${base.replace(/\/$/, '')}${path}`;

// Data pro tento ročník
const talks = frontKonData.talks.filter((t) => t.yearId === year.id).sort((a, b) => a.time.localeCompare(b.time));
const workshops = frontKonData.workshops.filter((w) => w.yearId === year.id);
const partners = frontKonData.partners.filter((p) => p.yearId === year.id);
const mainPartners = partners.filter((p) => p.type === 'main');
const otherPartners = partners.filter((p) => p.type !== 'main');

// Řečníci pro tento ročník
const speakerIds = [...new Set(talks.map((t) => t.speakerId))];
const allSpeakers = speakerIds
  .map((id) => frontKonData.speakers.find((s) => s.id === id))
  .filter((s): s is NonNullable<typeof s> => s !== undefined)
  .sort((a, b) => a.name.localeCompare(b.name));

// Hlavní řečníci (6)
const highlightedSpeakerIds = year.highlightedSpeakerIds || [];
const highlightedSpeakers = highlightedSpeakerIds
  .map((id) => frontKonData.speakers.find((s) => s.id === id))
  .filter((s): s is NonNullable<typeof s> => s !== undefined)
  .slice(0, 6);

// Ostatní řečníci (20-25)
const otherSpeakers = allSpeakers
  .filter((s) => !highlightedSpeakerIds.includes(s.id))
  .slice(0, 25);

// Nejčastější témata (3-5)
const topicCounts = new Map<string, number>();
talks.forEach((talk) => {
  talk.topicIds.forEach((topicId) => {
    topicCounts.set(topicId, (topicCounts.get(topicId) || 0) + 1);
  });
});
const topTopics = Array.from(topicCounts.entries())
  .sort((a, b) => b[1] - a[1])
  .slice(0, 5)
  .map(([topicId]) => frontKonData.topics.find((t) => t.id === topicId))
  .filter((t): t is NonNullable<typeof t> => t !== undefined);

// Statistiky
const stats = {
  talks: talks.length,
  speakers: allSpeakers.length,
  workshops: workshops.length,
  participants: year.participantsCount || 0,
  topics: [...new Set(talks.flatMap((t) => t.topicIds))].length,
};

// Fotky pro tento ročník
const allYearPhotos = frontKonData.photos.filter(p => p.yearId === year.id);
// Rozdělit fotky na kategorie
const talkPhotos = allYearPhotos.filter(
  p => p.talkId || p.speakerId
);
const otherPhotos = allYearPhotos.filter(
  p => !p.talkId && !p.speakerId
);

// Program - stejná struktura jako v /prednasky/
const timeSlots = ['09:00', '10:00', '11:00', '12:00', '13:00', '14:00', '15:00', '16:00', '17:00', '18:00', '19:00', '20:00'];
const schedule: { time: string; stages: { stage: string; talk: typeof talks[0] | null }[] }[] = [];

timeSlots.forEach((time) => {
  schedule.push({
    time,
    stages: ['A', 'B', 'C'].map((stage) => ({
      stage,
      talk: talks.find((t) => t.stage === stage && t.time === time) || null,
    })),
  });
});

const t = getTranslationObject(lang, 'archive', 'yearPage');
const archiveT = getTranslationObject(lang, 'archive');
const prednaskyT = getTranslationObject(lang, 'prednasky');
---

<BaseLayout title={`FrontKon ${year.year}`} lang={lang} description={year.metaDescription ? getText(year.metaDescription, lang) : undefined}>
  <!-- Banner o starším ročníku -->
  <section style="background: rgba(0, 0, 34, 0.05); border-bottom: 1px solid rgba(0, 0, 34, 0.1); padding: 1rem 0; margin-bottom: 2rem;">
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 1rem; text-align: center;">
      <p style="color: rgba(0, 0, 34, 0.7); font-size: 18px;">
        {lang === 'cs' 
          ? `Toto je landing page staršího ročníku FrontKon ${year.year}. Aktuální ročník najdeš na ` 
          : `This is a landing page for an older FrontKon ${year.year} edition. Find the current edition on `}
        <a href={pref(`/${lang}/`)} style="color: rgb(0, 0, 34); text-decoration: underline; font-weight: 600;">{lang === 'cs' ? 'homepage' : 'homepage'}</a>.
      </p>
    </div>
  </section>

  <!-- Hero sekce -->
  <section class="hero-wireframe">
    <div class="hero-content">
      <p class="eyebrow">{year.date} · {year.location}</p>
      <h2 class="hero-title">FrontKon {year.year}</h2>
      {year.claim && <p class="hero-tagline">{getText(year.claim, lang)}</p>}
      {year.description && (
        <div style="max-width: 800px; margin: 2rem auto 0;">
          <p class="hero-meta">{getText(year.description, lang)}</p>
        </div>
      )}
    </div>
  </section>

  <!-- Statistiky -->
  <section class="section">
    <div class="section-header">
      <h2>{lang === 'cs' ? 'O ročníku' : 'About the year'}</h2>
    </div>
    <div class="grid features-grid" style="grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); align-items: stretch;">
      <div class="card" style="text-align: center; display: flex; flex-direction: column; justify-content: center;">
        <h3 style="font-size: 48px; margin-bottom: 0.5rem; color: rgb(0, 0, 34);">{stats.talks}</h3>
        <p class="modal-description">{t.stats.talks}</p>
      </div>
      <div class="card" style="text-align: center; display: flex; flex-direction: column; justify-content: center;">
        <h3 style="font-size: 48px; margin-bottom: 0.5rem; color: rgb(0, 0, 34);">{stats.speakers}</h3>
        <p class="modal-description">{t.stats.speakers}</p>
      </div>
      {stats.workshops > 0 && (
        <div class="card" style="text-align: center; display: flex; flex-direction: column; justify-content: center;">
          <h3 style="font-size: 48px; margin-bottom: 0.5rem; color: rgb(0, 0, 34);">{stats.workshops}</h3>
          <p class="modal-description">{t.stats.workshops}</p>
        </div>
      )}
      {stats.participants > 0 && (
        <div class="card" style="text-align: center; display: flex; flex-direction: column; justify-content: center;">
          <h3 style="font-size: 48px; margin-bottom: 0.5rem; color: rgb(0, 0, 34);">{stats.participants}</h3>
          <p class="modal-description">{t.stats.participants}</p>
        </div>
      )}
      <div class="card" style="text-align: center; display: flex; flex-direction: column; justify-content: center;">
        <h3 style="font-size: 48px; margin-bottom: 0.5rem; color: rgb(0, 0, 34);">{stats.topics}</h3>
        <p class="modal-description">{t.stats.topics}</p>
      </div>
    </div>
  </section>

  <!-- Vzpomínky - Video a fotogalerie -->
  {(year.mainVideoId || year.photoGalleryUrl || year.youtubePlaylistId) && (
    <section class="section">
      <div class="section-header">
        <h2>{t.memories.title} {year.year}</h2>
        <p class="subtitle">{t.memories.subtitle}</p>
      </div>
      {(year.mainVideoId || year.photoGalleryUrl) && (
        <div style="max-width: 800px; margin: 0 auto 2rem;">
          <div class="video-container" style="margin-bottom: 1rem;">
            <div class="card" style="aspect-ratio: 16/9; display: flex; align-items: center; justify-content: center; padding: 0;">
              <p style="color: rgba(0, 0, 34, 0.5); font-size: 18px;">Video placeholder</p>
            </div>
          </div>
        </div>
      )}
      {/* Fotky z přednášek */}
      {talkPhotos.length > 0 && (
        <div style="margin-bottom: 3rem;">
          <h3 style="font-size: 24px; font-weight: 600; color: rgb(0, 0, 34); margin-bottom: 1.5rem;">
            {lang === 'cs' ? 'Fotky z přednášek' : 'Photos from talks'}
          </h3>
          <PhotoGallery 
            photos={talkPhotos} 
            lang={lang} 
            galleryId={`year-${year.id}-talks`} 
            showPlaceholders={true} 
          />
        </div>
      )}

      {/* Ostatní fotky */}
      {otherPhotos.length > 0 && (
        <div style="margin-bottom: 2rem;">
          <h3 style="font-size: 24px; font-weight: 600; color: rgb(0, 0, 34); margin-bottom: 1.5rem;">
            {lang === 'cs' ? 'Ostatní fotky' : 'Other photos'}
          </h3>
          <PhotoGallery 
            photos={otherPhotos} 
            lang={lang} 
            galleryId={`year-${year.id}-other`} 
            showPlaceholders={true} 
          />
        </div>
      )}
      <div class="cta-row" style="justify-content: center; margin-top: 2rem;">
        {year.youtubePlaylistId && (
          <a class="btn-secondary" href={`https://www.youtube.com/playlist?list=${year.youtubePlaylistId}`} target="_blank" rel="noopener noreferrer">
            {t.memories.watchVideos}
          </a>
        )}
        {year.photoGalleryUrl && (
          <a class="btn-secondary" href={year.photoGalleryUrl} target="_blank" rel="noopener noreferrer">
            {t.memories.viewGallery}
          </a>
        )}
      </div>
    </section>
  )}

  <!-- Řečníci -->
  <section class="section">
    <div class="section-header">
      <h2>{t.speakers.title}</h2>
      <p class="subtitle">{t.speakers.subtitle}</p>
    </div>
    {highlightedSpeakers.length > 0 && (
      <div class="grid" style="grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-bottom: 2rem;">
        {highlightedSpeakers.map((speaker) => (
          <div class="card">
            <a class="card-link" href={pref(`/${lang}/speakers/${speaker.id}/`)} style="text-decoration: none; color: inherit;">
              <div class="speaker-avatar-large">
                <div class="avatar-placeholder-image"></div>
              </div>
              <h3>{speaker.name}</h3>
              <p class="modal-company">{speaker.company}</p>
              <p class="modal-description">{getText(speaker.bio, lang)}</p>
            </a>
            {speaker.links && (
              <div class="modal-links" style="margin-top: 1rem;">
                {speaker.links.twitter && <a href={`https://twitter.com/${speaker.links.twitter.replace('@', '')}`} target="_blank" rel="noopener noreferrer">Twitter</a>}
                {speaker.links.github && <a href={`https://github.com/${speaker.links.github}`} target="_blank" rel="noopener noreferrer">GitHub</a>}
                {speaker.links.web && <a href={speaker.links.web} target="_blank" rel="noopener noreferrer">Web</a>}
                {speaker.links.linkedin && <a href={`https://www.linkedin.com/in/${speaker.links.linkedin}`} target="_blank" rel="noopener noreferrer">LinkedIn</a>}
              </div>
            )}
          </div>
        ))}
      </div>
    )}
    {otherSpeakers.length > 0 && (
      <div class="grid" style="grid-template-columns: repeat(6, 1fr); gap: 1rem; margin-top: 2rem;">
        {otherSpeakers.map((speaker) => (
          <div class="card">
            <a class="card-link" href={pref(`/${lang}/speakers/${speaker.id}/`)} style="text-decoration: none; color: inherit;">
              <div class="speaker-avatar-large">
                <div class="avatar-placeholder-image"></div>
              </div>
              <h3>{speaker.name}</h3>
              <p class="modal-company">{speaker.company}</p>
              <p class="modal-description">{getText(speaker.bio, lang)}</p>
            </a>
            {speaker.links && (
              <div class="modal-links" style="margin-top: 1rem;">
                {speaker.links.twitter && <a href={`https://twitter.com/${speaker.links.twitter.replace('@', '')}`} target="_blank" rel="noopener noreferrer">Twitter</a>}
                {speaker.links.github && <a href={`https://github.com/${speaker.links.github}`} target="_blank" rel="noopener noreferrer">GitHub</a>}
                {speaker.links.web && <a href={speaker.links.web} target="_blank" rel="noopener noreferrer">Web</a>}
                {speaker.links.linkedin && <a href={`https://www.linkedin.com/in/${speaker.links.linkedin}`} target="_blank" rel="noopener noreferrer">LinkedIn</a>}
              </div>
            )}
          </div>
        ))}
      </div>
    )}
  </section>

  <!-- Program konference -->
  <section class="section">
    <div class="section-header">
      <h2>{t.program.title}</h2>
      <p class="subtitle">{t.program.subtitle}</p>
    </div>
    {topTopics.length > 0 && (
      <div style="margin-bottom: 2rem;">
        <h3 style="font-size: 24px; font-weight: 600; color: rgb(0, 0, 34); margin-bottom: 1rem;">{lang === 'cs' ? 'Hlavní témata' : 'Main topics'}</h3>
        <div class="cta-row" style="justify-content: center; flex-wrap: wrap; gap: 1rem;">
          {topTopics.map((topic) => (
            <a class="btn-secondary" href={pref(`/${lang}/archiv/temata/?topic=${topic.id}&year=${year.id}`)}>
              {getText(topic.name, lang)}
            </a>
          ))}
        </div>
      </div>
    )}
    <div class="schedule-container">
      {schedule.filter((slot) => slot.stages.some((s) => s.talk)).map((slot) => (
        <div class="schedule-row">
          <div class="schedule-time">{slot.time}</div>
          <div class="schedule-stages">
            {slot.stages.map(({ stage, talk }) => (
              <div class={`schedule-stage ${talk ? 'has-talk' : 'empty'}`}>
                {talk ? (
                  <a class="card-link schedule-talk" href={pref(`/${lang}/talks/${talk.id}/`)}>
                    <div class="schedule-stage-label">{prednaskyT.stage} {stage}</div>
                    <div class="schedule-talk-title">{getText(talk.title, lang)}</div>
                    <div class="schedule-talk-speaker">{frontKonData.speakers.find((s) => s.id === talk.speakerId)?.name}</div>
                    <div class="schedule-talk-topics">{mapTopics(frontKonData.topics, talk.topicIds, lang).join(', ')}</div>
                    {talk.language === 'en' && <div class="schedule-talk-lang">EN</div>}
                  </a>
                ) : (
                  <div class="schedule-empty">
                    <div class="schedule-stage-label">{prednaskyT.stage} {stage}</div>
                    <div class="schedule-empty-text">{prednaskyT.break || (lang === 'cs' ? 'Přestávka' : 'Break')}</div>
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>


  <!-- Workshopy -->
  {workshops.length > 0 && (
    <section class="section">
      <div class="section-header">
        <h2>{t.workshops.title}</h2>
        <p class="subtitle">{t.workshops.subtitle}</p>
      </div>
      <div class="grid workshops-grid">
        {workshops.slice(0, 6).map((ws) => {
          const speaker = frontKonData.speakers.find((s) => s.id === ws.speakerId);
          return (
            <div class="card">
              <h3>{getText(ws.title, lang)}</h3>
              <p class="modal-description">{getText(ws.description, lang)}</p>
              <p class="list-meta">{ws.duration} {getTranslation(lang, 'workshops', 'min')} · {getTranslation(lang, 'workshops', 'capacityLabel')} {ws.capacity} · {ws.price}</p>
              {speaker && <p class="list-meta" style="margin-top: 0.5rem;">{speaker.name}</p>}
              <div style="margin-top: 1rem;">
                <a class="btn-secondary" href={pref(`/${lang}/workshopy/${ws.id}/`)}>{lang === 'cs' ? 'Detail workshopu' : 'Workshop details'}</a>
              </div>
            </div>
          );
        })}
      </div>
    </section>
  )}

  <!-- Partneři -->
  {partners.length > 0 && (
    <section class="section">
      <div class="section-header">
        <h2>{t.partners.title}</h2>
        <p class="subtitle">{t.partners.subtitle}</p>
      </div>
      <div class="partners-container">
        {mainPartners.map((partner) => (
          <div class="partner-main-wrapper">
            <a class="card partner-card partner-main" href={partner.url} target="_blank" rel="noopener noreferrer">
              <p class="list-title">{partner.name}</p>
              <p class="modal-description">{t.partners.mainPartner}</p>
            </a>
          </div>
        ))}
        <div class="partners-grid">
          {otherPartners.map((partner) => (
            <a class="card partner-card" href={partner.url} target="_blank" rel="noopener noreferrer">
              <p class="list-title">{partner.name}</p>
              <p class="modal-description">
                {partner.type === 'afterparty' ? t.partners.afterpartyPartner : t.partners.partner}
              </p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Navigace v archívu -->
  <section class="section">
    <div class="section-header">
      <h2>{t.navigation.title}</h2>
      <p class="subtitle">{t.navigation.subtitle}</p>
    </div>
    <div class="grid">
      <a class="card card-link" href={pref(`/${lang}/archiv/prednasky/?year=${year.id}`)}>
        <h3>{archiveT.talks.title}</h3>
        <p class="modal-description">{archiveT.talks.description}</p>
      </a>
      <a class="card card-link" href={pref(`/${lang}/archiv/temata/?year=${year.id}`)}>
        <h3>{archiveT.topics.title}</h3>
        <p class="modal-description">{archiveT.topics.description}</p>
      </a>
      <a class="card card-link" href={pref(`/${lang}/archiv/spikri/?year=${year.id}`)}>
        <h3>{archiveT.speakers.title}</h3>
        <p class="modal-description">{archiveT.speakers.description}</p>
      </a>
    </div>
  </section>

  <!-- React komponenta pro lightbox napříč všemi fotkami -->
  {allYearPhotos.length > 0 && (
    <PhotoGalleryManager 
      client:load 
      allPhotos={allYearPhotos.map(p => ({
        id: p.id,
        url: p.url,
        thumbnailUrl: p.thumbnailUrl,
        alt: getText(p.alt, lang)
      }))} 
    />
  )}
</BaseLayout>

<style>
  .schedule-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 2rem;
  }

  .schedule-row {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  .schedule-time {
    font-weight: 600;
    font-size: 20px;
    color: rgb(0, 0, 34);
    padding-top: 0.5rem;
  }

  .schedule-stages {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .schedule-stage {
    border: 1px solid rgba(0, 0, 34, 0.1);
    background: #f7f7f7;
    padding: 1rem;
    min-height: 120px;
  }

  .schedule-stage.empty {
    background: #f9f9f9;
    opacity: 0.6;
  }

  .schedule-stage-label {
    font-size: 14px;
    text-transform: uppercase;
    color: rgba(0, 0, 34, 0.6);
    margin-bottom: 0.5rem;
  }

  .schedule-talk {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .schedule-talk-title {
    font-weight: 600;
    font-size: 18px;
    color: rgb(0, 0, 34);
    margin-bottom: 0.5rem;
  }

  .schedule-talk-speaker {
    font-size: 16px;
    color: rgba(0, 0, 34, 0.7);
    margin-bottom: 0.5rem;
  }

  .schedule-talk-topics {
    font-size: 14px;
    color: rgba(0, 0, 34, 0.6);
    margin-bottom: 0.5rem;
  }

  .schedule-talk-lang {
    display: inline-block;
    padding: 0.25rem 0.5rem;
    background: rgba(0, 0, 34, 0.1);
    font-size: 12px;
    font-weight: 600;
    margin-top: 0.5rem;
  }

  .schedule-empty-text {
    font-size: 14px;
    color: rgba(0, 0, 34, 0.5);
  }

  .partners-container {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .partner-main-wrapper {
    display: flex;
    justify-content: center;
  }

  .partner-card {
    text-align: center;
    text-decoration: none;
    color: inherit;
  }

  .partner-main {
    max-width: 400px;
  }

  .partners-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
  }

  @media (max-width: 1024px) {
    .grid[style*="grid-template-columns: repeat(6"] {
      grid-template-columns: repeat(3, 1fr) !important;
    }
  }

  @media (max-width: 768px) {
    .schedule-row {
      grid-template-columns: 1fr;
    }

    .schedule-time {
      margin-bottom: 0.5rem;
    }

    .schedule-stages {
      grid-template-columns: 1fr;
    }

    .grid[style*="grid-template-columns: repeat(3"] {
      grid-template-columns: 1fr !important;
    }

    .grid[style*="grid-template-columns: repeat(6"] {
      grid-template-columns: repeat(2, 1fr) !important;
    }
  }
</style>
